  "record_schema": "../access/ovip/VISIT_RECORD_SCHEMA.json",
  "access_protocol": "../access/ACCESS_PROTOCOL.md",
  "introspection_protocol": "../access/ovip/INTROSPECTION_PROTOCOL.md",
  "privacy_policy": "../access/ovip/PRIVACY_AND_REVIEW.md"
